{
  "rules": {
    "config": {
      ".read": true,
      ".write": false
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "rating"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$msg": {
          ".write": "auth != null"
        }
      }
    },
    "queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "rooms": {
      "$rid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "live": {
      "$rid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "input": {
      "$rid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}